{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getyourmuscle",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public URL of the Fly.io API (fly.toml app name + .fly.dev); scripts/deploy-cloud.sh
    // passes the real one with --var. PROXY_SECRET is a secret (`wrangler secret put`).
    "API_ORIGIN": "https://getyourmuscle-api.fly.dev"
  }
}
